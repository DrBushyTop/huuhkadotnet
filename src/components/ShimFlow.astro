---
// The three kinds of request the shim handles, all through one Entra ID token.
// Everything is readable without JavaScript; the script only plays each request.
import DiagramIcon from './DiagramIcon.astro';
type Line = {text: string; mono?: boolean};
// Each column has a role: the app asking, the shim on my machine, and Foundry.
const roles = {req: {hue: 'client', icon: 'mic'}, work: {hue: 'server', icon: 'shim'}, target: {hue: 'cloud', icon: 'foundry'}} as const;
type Cell = {col: 'req' | 'work' | 'target'; label: string; title?: string; lines: Line[]};
const lanes: {id: string; input: 'audio' | 'text'; cells: Cell[]}[] = [
  {id: 'dictation', input: 'audio', cells: [
    {col: 'req', label: 'OpenWhispr', title: 'Dictation', lines: [{text: 'POST /audio/transcriptions', mono: true}]},
    {col: 'work', label: 'Shim', lines: [{text: 'Converts the audio with ffmpeg'}, {text: 'Adds the dictionary as a phrase list'}]},
    {col: 'target', label: 'Foundry', title: 'LLM Speech', lines: [{text: 'MAI-Transcribe-2 if it doesn’t answer'}]},
  ]},
  {id: 'cleanup', input: 'text', cells: [
    {col: 'req', label: 'OpenWhispr', title: 'Cleanup', lines: [{text: 'POST /chat/completions', mono: true}]},
    {col: 'work', label: 'Shim', lines: [{text: 'Renames max_tokens'}, {text: 'Turns the thinking toggle into reasoning_effort'}]},
    {col: 'target', label: 'Foundry', title: 'gpt-5.4-mini', lines: [{text: 'Streams the answer back'}]},
  ]},
  {id: 'meeting', input: 'audio', cells: [
    {col: 'req', label: 'OpenWhispr Patched', title: 'Meetings', lines: [{text: 'WebSocket /realtime', mono: true}]},
    {col: 'work', label: 'Shim', lines: [{text: 'Cuts the audio at pauses'}, {text: 'Keeps my mic and the others apart'}]},
    {col: 'target', label: 'Foundry', title: 'MAI-Transcribe-2', lines: [{text: 'One request per segment'}]},
  ]},
];
const lock = '<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><rect x="3" y="7" width="10" height="7" rx="1.5" fill="currentColor"/><path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>';
---
<figure class="reader-figure shim-flow" data-width="wide" data-shim-flow aria-label="How the shim handles each kind of request">
  <div class="sf-stage">
    {lanes.map((lane, i) => (
      <div class="sf-lane" data-lane={i} data-input={lane.input}>
        <div class="sf-rail" aria-hidden="true"></div>
        {lane.cells.map((cell, j) => (
          <>
            {j === 2 && <span class="sf-chip" data-stop="gate"><Fragment set:html={lock} />Entra ID token</span>}
            <div class="sf-cell" data-col={cell.col} data-stop={cell.col} style={`--hue: var(--diagram-${roles[cell.col].hue})`}>
              <span class="sf-head"><DiagramIcon name={roles[cell.col].icon} /><span class="sf-label">{cell.label}</span></span>
              {cell.title && <span class="sf-title">{cell.title}</span>}
              {cell.lines.map(line => <span class:list={['sf-line', {mono: line.mono}]}>{line.text}</span>)}
            </div>
          </>
        ))}
      </div>
    ))}
    <div class="sf-gate" data-stop="gate">
      <Fragment set:html={lock} />
      <span class="sf-gate-name">Entra ID token</span>
      <span class="sf-gate-line">from az CLI, cached until it’s about to expire</span>
    </div>
    <span class="sf-token" data-form="audio" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="22" height="22">
        <g class="sf-wave">{[4, 8, 12, 16, 20].map((x, i) => <rect x={x - 1} y={[9, 5, 3, 6, 9][i]} width="2" height={[6, 14, 18, 12, 6][i]} rx="1" />)}</g>
        <g class="sf-text">{[7, 12, 17].map((y, i) => <rect x="4" y={y - 1} width={[16, 16, 10][i]} height="2" rx="1" />)}</g>
      </svg>
    </span>
  </div>
  <figcaption>
    <span>What the shim does with each kind of request. All of them go to Foundry with the same token.</span>
    <button type="button" class="sf-replay" hidden>Play again</button>
  </figcaption>
</figure>

<style>
  .shim-flow { margin-block: 40px; }
  .sf-stage { position: relative; font-family: var(--brand-font); }
  .sf-rail { height: 2px; background: var(--line); border-radius: 1px; }
  .sf-cell {
    display: flex; flex-direction: column; gap: 3px; padding: 12px 14px;
    background: color-mix(in oklab, var(--hue) 6%, var(--popular-ground));
    border: 1px solid color-mix(in oklab, var(--hue) 30%, var(--line)); border-radius: 12px;
    transition: border-color 200ms ease-out, background-color 200ms ease-out;
  }
  .sf-head { display: flex; align-items: center; gap: 10px; margin-bottom: 4px; }
  .sf-label { font-family: var(--nav-font); font-size: 10px; line-height: 1.6; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
  .sf-title { color: var(--ink); font-size: 15px; font-weight: 600; letter-spacing: -0.01em; }
  .sf-line { color: var(--muted); font-family: var(--body-font); font-size: 14px; line-height: 1.35; overflow-wrap: anywhere; }
  .sf-line.mono { font-family: var(--nav-font); font-size: 12px; }
  .sf-cell[data-col="work"] .sf-line { color: var(--ink); }
  .sf-gate, .sf-chip {
    color: var(--muted); background: var(--paper); border: 1px solid var(--line); font-family: var(--nav-font);
    transition: color 200ms ease-out, border-color 200ms ease-out, background-color 200ms ease-out;
  }
  :is(.sf-gate, .sf-chip) :global(svg) { color: var(--diagram-auth); }
  .sf-gate :global(svg) { width: 16px; height: 16px; }
  .sf-gate {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px;
    padding: 16px 10px; border-radius: 12px; text-align: center; z-index: 1;
  }
  .sf-gate-name { font-size: 11px; letter-spacing: 0.02em; color: inherit; }
  .sf-gate-line { font-family: var(--body-font); font-size: 13px; line-height: 1.35; color: var(--muted); }
  .sf-chip { display: none; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 999px; font-size: 11px; letter-spacing: 0.02em; white-space: nowrap; }
  .sf-token {
    position: absolute; left: 0; top: 0; z-index: 2; display: none; place-items: center;
    width: 36px; height: 36px; margin: -18px 0 0 -18px; border-radius: 50%;
    background: var(--accent); color: var(--paper); outline: 4px solid var(--paper);
  }
  .sf-token svg { fill: currentColor; overflow: visible; }
  .sf-token g { transition: opacity 180ms ease-out; }
  .sf-token .sf-text, .sf-token[data-form="text"] .sf-wave { opacity: 0; }
  .sf-token[data-form="text"] .sf-text { opacity: 1; }
  .sf-wave rect { transform-box: fill-box; transform-origin: center; }
  .shim-flow figcaption { display: flex; flex-wrap: wrap; justify-content: center; align-items: baseline; gap: 4px 16px; margin-inline: auto; max-width: 720px; }
  .sf-replay {
    min-height: 32px; padding: 4px 12px; border: 1px solid var(--control-border); border-radius: 6px;
    background: var(--paper); color: var(--ink); font: 13px var(--nav-font); cursor: pointer;
    transition: background-color 150ms ease-out;
  }
  .sf-replay:hover { background: var(--nav-highlight); }
  .sf-replay:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }

  /* Active states, set by the script while a request plays. */
  .sf-cell[data-active] { border-color: var(--hue); background: color-mix(in oklab, var(--hue) 14%, var(--popular-ground)); }
  :is(.sf-gate, .sf-chip)[data-active] { color: var(--ink); border-color: var(--diagram-auth); background: color-mix(in oklab, var(--diagram-auth) 14%, var(--paper)); }
  .sf-gate[data-active] { background: color-mix(in oklab, var(--diagram-auth) 7%, var(--paper)); }
  .shim-flow[data-ready] .sf-token { display: grid; }

  /* Wide: one row per request, all crossing the same token column. */
  @media (min-width: 761px) {
    .sf-stage {
      display: grid; column-gap: 12px;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr) 132px minmax(0, 1fr);
      grid-template-rows: 36px auto 36px auto 36px auto;
    }
    .sf-lane { display: contents; }
    .sf-rail { grid-column: 1 / -1; align-self: center; margin-inline: 48px; }
    .sf-cell[data-col="req"] { grid-column: 1; }
    .sf-cell[data-col="work"] { grid-column: 2; }
    .sf-cell[data-col="target"] { grid-column: 4; }
    .sf-lane[data-lane="0"] > .sf-rail { grid-row: 1; } .sf-lane[data-lane="0"] > .sf-cell { grid-row: 2; }
    .sf-lane[data-lane="1"] > .sf-rail { grid-row: 3; } .sf-lane[data-lane="1"] > .sf-cell { grid-row: 4; }
    .sf-lane[data-lane="2"] > .sf-rail { grid-row: 5; } .sf-lane[data-lane="2"] > .sf-cell { grid-row: 6; }
    .sf-gate { grid-column: 3; grid-row: 1 / -1; }
  }
  /* Narrow: each request stacks down its own rail, with the token check inline. */
  @media (max-width: 760px) {
    .sf-stage { display: flex; flex-direction: column; gap: 28px; }
    .sf-gate { display: none; }
    .sf-lane { display: grid; grid-template-columns: 44px minmax(0, 1fr); row-gap: 8px; }
    .sf-rail { grid-column: 1; grid-row: 1 / span 4; justify-self: center; width: 2px; height: auto; margin-block: 30px; }
    .sf-lane > :is(.sf-cell, .sf-chip) { grid-column: 2; }
    .sf-chip { display: inline-flex; justify-self: start; margin-left: 12px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sf-cell, .sf-gate, .sf-chip, .sf-token g { transition-duration: 1ms; }
  }
</style>

<script>
  import { animate, inView, stagger } from 'motion';

  const ease = [0.16, 1, 0.3, 1] as const;
  const order = ['req', 'work', 'gate', 'target'];

  for (const root of document.querySelectorAll<HTMLElement>('[data-shim-flow]')) setup(root);

  function setup(root: HTMLElement) {
    const stage = root.querySelector<HTMLElement>('.sf-stage')!;
    const lanes = [...root.querySelectorAll<HTMLElement>('.sf-lane')];
    const pillar = root.querySelector<HTMLElement>('.sf-gate')!;
    const token = root.querySelector<HTMLElement>('.sf-token')!;
    const bars = [...token.querySelectorAll<SVGRectElement>('.sf-wave rect')];
    const replay = root.querySelector<HTMLButtonElement>('.sf-replay')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let run = 0;
    let at = {lane: 0, stop: 0};
    let running: {stop(): void}[] = [];
    let moving = false;
    let played = false;

    // The shared token column shows on wide screens; phones get a chip per request.
    function stopEl(lane: number, stop: number) {
      const name = order[stop];
      if (name === 'gate' && pillar.getClientRects().length) return pillar;
      return lanes[lane].querySelector<HTMLElement>(`[data-stop="${name}"]`)!;
    }
    // Rails run across on wide screens and down on phones; place the token on one.
    function point(lane: number, stop: number) {
      const s = stage.getBoundingClientRect();
      const r = lanes[lane].querySelector('.sf-rail')!.getBoundingClientRect();
      const t = stopEl(lane, stop).getBoundingClientRect();
      return r.width >= r.height
        ? {x: t.left + t.width / 2 - s.left, y: r.top + r.height / 2 - s.top}
        : {x: r.left + r.width / 2 - s.left, y: t.top + t.height / 2 - s.top};
    }
    function place(lane: number, stop: number) {
      const p = point(lane, stop);
      animate(token, {x: p.x, y: p.y}, {duration: 0});
      at = {lane, stop};
    }

    const keep = <T extends {stop(): void}>(a: T) => (running.push(a), a);
    const pause = (ms: number) => new Promise(r => setTimeout(r, reduced.matches ? ms * 1.4 : ms));
    const clear = () => root.querySelectorAll('[data-active]').forEach(el => el.removeAttribute('data-active'));

    async function move(lane: number, stop: number, seconds: number) {
      const p = point(lane, stop);
      moving = true;
      await keep(animate(token, {x: p.x, y: p.y}, {duration: reduced.matches ? 0 : seconds, ease}));
      moving = false;
      at = {lane, stop};
    }

    async function play() {
      const id = ++run;
      const live = () => id === run;
      running.forEach(a => a.stop());
      running = [];
      moving = false;
      clear();
      place(0, 0);

      for (let lane = 0; lane < lanes.length && live(); lane++) {
        clear();
        token.dataset.form = lanes[lane].dataset.input;
        if (lane > 0) { await move(lane, 0, 0.6); if (!live()) return; }
        stopEl(lane, 0).setAttribute('data-active', '');
        if (token.dataset.form === 'audio' && !reduced.matches) {
          keep(animate(bars, {scaleY: [1, 0.35, 1, 0.55, 1]}, {duration: 1, delay: stagger(0.08)}));
        }
        await pause(900); if (!live()) return;

        // Out through the shim and the token check to Foundry.
        for (let stop = 1; stop < order.length; stop++) {
          await move(lane, stop, 0.55); if (!live()) return;
          stopEl(lane, stop).setAttribute('data-active', '');
          await pause(stop === 1 ? 700 : 300); if (!live()) return;
        }
        await pause(300); if (!live()) return;
        token.dataset.form = 'text';
        await keep(animate(token, {scale: [1, 1.15, 1]}, {duration: reduced.matches ? 0 : 0.35, ease}));
        await pause(500); if (!live()) return;

        // And straight back to OpenWhispr.
        await move(lane, 0, 0.8); if (!live()) return;
        await pause(700);
      }
      if (live()) clear();
    }

    root.setAttribute('data-ready', '');
    place(0, 0);
    replay.hidden = false;
    replay.addEventListener('click', () => play());
    new ResizeObserver(() => { if (!moving) place(at.lane, at.stop); }).observe(stage);
    // Play once on the first visit; the button replays it.
    inView(root, () => { if (!played) { played = true; play(); } }, {amount: 0.5});
  }
</script>
