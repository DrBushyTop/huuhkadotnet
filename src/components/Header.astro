---
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import '@fontsource-variable/geist-mono';
---
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Huuhka.net home">
      <svg class="brand-mark" width="30" height="34" viewBox="0 0 30 34" aria-hidden="true">
        <path fill="currentColor" d="M2 3 9 1v13l12-4V3l7-2v30l-7 2V18L9 22v9l-7 2Z" />
      </svg>
      <span>Huuhka.net</span>
    </a>
    <nav class="main-nav" aria-label="Main navigation">
      <a href="/" aria-current={Astro.url.pathname === "/" ? "page" : undefined}>Articles</a>
      <a href="https://github.com/DrBushyTop/presentations">Presentations</a>
      <a href="https://www.meetup.com/finland-azure-user-group/">Finland Azure User Group</a>
      <a href="https://www.iglooconf.fi/">IglooConf</a>
    </nav>
    <nav class="social-nav" aria-label="Social links">
      <a href="https://www.linkedin.com/in/pasihuuhka/" aria-label="Pasi on LinkedIn"><Icon name="linkedin" /></a>
      <a href="https://github.com/DrBushyTop" aria-label="Pasi on GitHub"><Icon name="github" /></a>
      <a href="https://sessionize.com/pasi-huuhka/" aria-label="Pasi on Sessionize" title="Sessionize"><Icon name="sessionize" /></a>
      <a href="/rss/" aria-label="Subscribe via RSS"><Icon name="rss" size={18} /></a>
      <ThemeToggle />
    </nav>
    <div class="mobile-header-actions">
      <button class="menu-toggle icon-button" type="button" aria-label="Open navigation menu" aria-controls="mobile-navigation" aria-expanded="false" hidden>
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>
</header>

<dialog id="mobile-navigation" class="mobile-navigation" aria-label="Site navigation">
  <div class="mobile-menu-inner">
    <div class="mobile-menu-header">
      <a class="brand" href="/" aria-label="Huuhka.net home">
        <svg class="brand-mark" width="30" height="34" viewBox="0 0 30 34" aria-hidden="true">
          <path fill="currentColor" d="M2 3 9 1v13l12-4V3l7-2v30l-7 2V18L9 22v9l-7 2Z" />
        </svg>
        <span>Huuhka.net</span>
      </a>
      <button class="menu-close icon-button" type="button" aria-label="Close navigation menu" autofocus><Icon name="close" size={22} /></button>
    </div>
    <nav class="mobile-page-links" aria-label="Pages">
      <a href="/" aria-current={Astro.url.pathname === "/" ? "page" : undefined}><span>Articles</span><Icon name="arrow" /></a>
      <a href="https://github.com/DrBushyTop/presentations"><span>Presentations</span><Icon name="external" /></a>
      <a href="https://www.meetup.com/finland-azure-user-group/"><span>Finland Azure User Group</span><Icon name="external" /></a>
      <a href="https://www.iglooconf.fi/"><span>IglooConf</span><Icon name="external" /></a>
    </nav>
    <div class="mobile-theme"><ThemeToggle /></div>
    <nav class="mobile-social-links" aria-label="Social links">
      <a href="https://www.linkedin.com/in/pasihuuhka/"><Icon name="linkedin" /><span>LinkedIn</span><Icon name="external" size={17} /></a>
      <a href="https://github.com/DrBushyTop"><Icon name="github" /><span>GitHub</span><Icon name="external" size={17} /></a>
      <a href="https://sessionize.com/pasi-huuhka/"><Icon name="sessionize" /><span>Sessionize</span><Icon name="external" size={17} /></a>
      <a href="/rss/"><Icon name="rss" size={18} /><span>RSS feed</span><Icon name="external" size={17} /></a>
    </nav>
  </div>
</dialog>

<script>
  const header = document.querySelector<HTMLElement>('.site-header')!;
  const toggle = header.querySelector<HTMLButtonElement>('.menu-toggle')!;
  const dialog = document.querySelector<HTMLDialogElement>('#mobile-navigation')!;
  const close = dialog.querySelector<HTMLButtonElement>('.menu-close')!;
  const desktop = window.matchMedia('(min-width: 1241px)');

  // Without scripting the ordinary navigation stays visible on mobile.
  header.classList.add('has-mobile-menu');
  toggle.hidden = false;

  toggle.addEventListener('click', () => {
    dialog.showModal();
    toggle.setAttribute('aria-expanded', 'true');
    document.documentElement.classList.add('navigation-open');
  });
  close.addEventListener('click', () => dialog.close());
  dialog.addEventListener('close', () => {
    toggle.setAttribute('aria-expanded', 'false');
    document.documentElement.classList.remove('navigation-open');
    if (!desktop.matches) toggle.focus({ preventScroll: true });
  });
  dialog.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => dialog.close());
  });
  desktop.addEventListener('change', (event) => {
    if (event.matches && dialog.open) {
      dialog.close();
      header.querySelector<HTMLAnchorElement>('.main-nav a[aria-current]')?.focus({ preventScroll: true });
    }
  });
</script>
