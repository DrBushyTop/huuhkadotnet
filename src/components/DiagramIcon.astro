---
// Role icons for article diagrams. The tile takes its hue from the parent's --hue.
// Foundry is Microsoft's Azure architecture icon; see docs/icon-sources.md.
interface Props { name: 'phone' | 'network' | 'server' | 'mic' | 'shim' | 'foundry' }
const { name } = Astro.props;
---
<span class="diagram-icon" aria-hidden="true">
  {name === 'foundry'
    ? <img src="/images/icons/azure-ai-foundry.svg" alt="" width="18" height="18" />
    : <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        {name === 'phone' && <><rect x="6.5" y="2.5" width="11" height="19" rx="2.5" /><path d="M10.5 18h3" /></>}
        {name === 'network' && <><circle cx="12" cy="5" r="2.2" /><circle cx="5" cy="18" r="2.2" /><circle cx="19" cy="18" r="2.2" /><path d="M10.9 6.9 6.1 16.1M13.1 6.9l4.8 9.2M7.2 18h9.6" /></>}
        {name === 'server' && <><rect x="3.5" y="4" width="17" height="7" rx="2" /><rect x="3.5" y="13" width="17" height="7" rx="2" /><path d="M7.5 7.5h.01M7.5 16.5h.01M11 7.5h5.5M11 16.5h5.5" /></>}
        {name === 'mic' && <><rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21" /></>}
        {name === 'shim' && <path d="M4 8h15m-3.5-3.5L19 8l-3.5 3.5M20 16H5m3.5-3.5L5 16l3.5 3.5" />}
      </svg>}
</span>

<style>
  .diagram-icon {
    display: inline-grid; place-items: center; flex-shrink: 0; width: 30px; height: 30px; border-radius: 8px;
    color: var(--hue, var(--muted)); background: color-mix(in oklab, var(--hue, var(--muted)) 16%, var(--popular-ground));
  }
  .diagram-icon img { display: block; margin: 0; border-radius: 0; }
</style>
