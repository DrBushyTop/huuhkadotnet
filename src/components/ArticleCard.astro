---
import type {CollectionEntry} from 'astro:content';
import {dateFormat,cardPost} from '../lib/posts';
import Icon from './Icon.astro';
import CardImage from './CardImage.astro';
interface Props {post:CollectionEntry<'blog'>}
const post=cardPost(Astro.props.post);
---
<article class="article-card">
  <a href={`/${post.slug}/`}>
    {post.image && <CardImage src={post.image} />}
    <div class="article-content">
      <ul class="article-tags" aria-label="Topics">{post.tags.slice(0,2).map(tag=><li>{tag}</li>)}</ul>
      <h3>{post.title}</h3>
      <div class="article-meta"><time datetime={post.publishedAt}>{dateFormat.format(new Date(post.publishedAt))}</time><span class="article-read-more" aria-hidden="true">Read more <Icon name="arrow" size={16} /></span></div>
    </div>
  </a>
</article>
