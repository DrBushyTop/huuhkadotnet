---
interface Props {
  name: 'github' | 'linkedin' | 'rss' | 'search' | 'arrow' | 'close' | 'external' | 'menu';
  size?: number;
}
const { name, size = 20 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" aria-hidden="true">
  {name === 'github' && <path fill="currentColor" d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.86c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.03A9.6 9.6 0 0 1 12 6.82c.85 0 1.71.11 2.51.34 1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.4.1 2.65.64.7 1.03 1.6 1.03 2.69 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" />}
  {name === 'linkedin' && <><rect x="3" y="3" width="18" height="18" rx="2" fill="currentColor" /><path fill="var(--paper, white)" d="M6.5 9h2.4v8.5H6.5zm1.2-4a1.4 1.4 0 1 0 0 2.8 1.4 1.4 0 0 0 0-2.8ZM11 9h2.3v1.2h.1c.3-.6 1.1-1.4 2.5-1.4 2.6 0 3.1 1.7 3.1 3.9v4.8h-2.4v-4.3c0-1 0-2.3-1.4-2.3s-1.6 1.1-1.6 2.2v4.4H11Z" /></>}
  {name === 'rss' && <><circle cx="5" cy="19" r="2" fill="currentColor" /><path d="M3 10a11 11 0 0 1 11 11M3 3a18 18 0 0 1 18 18" stroke="currentColor" stroke-width="2" /></>}
  {name === 'search' && <><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.7" /><path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></>}
  {name === 'arrow' && <path d="M4 12h15m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />}
  {name === 'close' && <path d="m6 6 12 12M6 18 18 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />}
  {name === 'external' && <path d="M7 17 17 7M7 7h10v10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />}
</svg>
