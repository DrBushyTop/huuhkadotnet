---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import {getPosts, cardPost} from '../lib/posts';
const posts = (await getPosts()).map(cardPost);

const popular = posts.slice(0, 3);
const dateFormat = new Intl.DateTimeFormat('en-GB', {
  day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC',
});
---
<Base title="Huuhka.net | Pasi Huuhka">
  <main id="main" class="page-width">
    <section class="introduction" aria-labelledby="author-name">
      <img class="portrait" src="/images/pasi.webp" alt="Pasi Huuhka" width="56" height="56" fetchpriority="high" />
      <div>
        <h1 id="author-name">Pasi Huuhka</h1>
        <p>DevOps, Azure, and building software with AI.</p>
      </div>
    </section>

    <section class="popular-section" aria-labelledby="popular-heading">
      <div class="section-heading">
        <h2 id="popular-heading">Popular articles</h2>
      </div>
      <div class="popular-grid">
        {popular.map((post) => (
          <a class="popular-card" href={post.url}>
            <img src={post.image || "/images/pasi.webp"} width="72" height="72" alt="" decoding="async" />
            <h3>{post.title}</h3>
            <span class="popular-arrow"><Icon name="external" size={17} /></span>
          </a>
        ))}
      </div>
    </section>

    <section class="archive" aria-labelledby="archive-heading">
      <div class="archive-heading">
        <h2 id="archive-heading">All articles</h2>
        <form class="search-form" role="search" hidden>
          <label for="article-search" class="sr-only">Search articles by title or topic</label>
          <Icon name="search" />
          <input id="article-search" type="search" name="q" placeholder="Search articles..." autocomplete="off" spellcheck="false" aria-controls="article-grid" />
          <button class="clear-search" type="button" aria-label="Clear search" hidden><Icon name="close" size={18} /></button>
        </form>
      </div>
      <p id="result-count" class="result-count" role="status" aria-live="polite" aria-atomic="true">{posts.length} articles</p>
      <div class="article-grid" id="article-grid">
        {posts.map((post, index) => (
          <article class="article-card" data-slug={post.slug}>
            <a href={post.url} aria-labelledby={`title-${post.slug}`}>
              <div class="article-image">
                <img src={post.image || "/images/pasi.webp"} alt="" width="960" height="504" loading={index < 3 ? 'eager' : 'lazy'} decoding="async" />
              </div>
              <div class="article-content">
                <ul class="article-tags" aria-label="Topics">
                  {post.tags.filter((tag) => tag !== 'Artificial Intelligence' || !post.tags.includes('AI')).slice(0, 2).map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
                <h3 id={`title-${post.slug}`}>{post.title}</h3>
                <div class="article-meta">
                  <time datetime={post.publishedAt}>{dateFormat.format(new Date(post.publishedAt))}</time>
                  <span class="article-read-more" aria-hidden="true">Read more <Icon name="arrow" size={16} /></span>
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>
      <div class="empty-state" hidden>
        <h3>No matching articles</h3>
        <p>Try a shorter title or a topic such as Azure, Bicep, or OpenCode.</p>
        <button class="text-button reset-search" type="button">Clear search <Icon name="arrow" size={18} /></button>
      </div>
      <div class="archive-pagination" hidden>
        <button class="load-more" type="button">Load more articles <Icon name="arrow" size={18} /></button>
        <span class="pagination-count"></span>
      </div>
      <noscript><p class="no-script">All {posts.length} articles are shown. Enable JavaScript to search by title or topic.</p></noscript>
    </section>
  </main>
</Base>

<script id="search-data" type="application/json" set:html={JSON.stringify(posts.map(({slug,title,tags}) => ({slug,title,tags}))).replaceAll("<", "\\u003c")} />

<script>
  const posts = JSON.parse(document.querySelector('#search-data')!.textContent!);
  import { createArticleSearch } from '../lib/search';

  const form = document.querySelector<HTMLFormElement>('.search-form')!;
  const input = document.querySelector<HTMLInputElement>('#article-search')!;
  const clearButton = document.querySelector<HTMLButtonElement>('.clear-search')!;
  const resetButton = document.querySelector<HTMLButtonElement>('.reset-search')!;
  const grid = document.querySelector<HTMLElement>('#article-grid')!;
  const status = document.querySelector<HTMLElement>('#result-count')!;
  const empty = document.querySelector<HTMLElement>('.empty-state')!;
  const pagination = document.querySelector<HTMLElement>('.archive-pagination')!;
  const loadMore = document.querySelector<HTMLButtonElement>('.load-more')!;
  const paginationCount = document.querySelector<HTMLElement>('.pagination-count')!;
  const cards = new Map(Array.from(grid.querySelectorAll<HTMLElement>('[data-slug]'))
    .map((card) => [card.dataset.slug!, card]));
  const search = createArticleSearch(posts);
  const pageSize = 12;
  let limit = pageSize;

  function render() {
    const query = input.value.trim();
    const matches = search(query);
    const visible = matches.slice(0, limit);
    const visibleSet = new Set(visible);
    for (const [slug, card] of cards) card.hidden = !visibleSet.has(slug);
    // Move existing elements rather than rebuilding HTML from query text.
    for (const slug of visible) grid.append(cards.get(slug)!);
    empty.hidden = matches.length > 0;
    grid.hidden = matches.length === 0;
    clearButton.hidden = input.value.length === 0;
    pagination.hidden = matches.length <= limit;
    const noun = matches.length === 1 ? 'article' : 'articles';
    status.textContent = query
      ? `${matches.length} ${noun} found${matches.length > limit ? ` · Showing ${visible.length}` : ''}`
      : `${visible.length} of ${posts.length} articles`;
    paginationCount.textContent = `${visible.length} of ${matches.length} articles`;
    loadMore.firstChild!.textContent = `Load ${Math.min(pageSize, matches.length - limit)} more articles `;
  }

  function updateSearch() {
    limit = pageSize;
    render();
    const url = new URL(window.location.href);
    if (input.value.trim()) url.searchParams.set('q', input.value.trim());
    else url.searchParams.delete('q');
    window.history.replaceState(null, '', url);
  }

  function resetSearch() {
    input.value = '';
    updateSearch();
    input.focus();
  }

  form.hidden = false;
  input.value = new URLSearchParams(window.location.search).get('q') ?? '';
  form.addEventListener('submit', (event) => { event.preventDefault(); updateSearch(); });
  input.addEventListener('input', updateSearch);
  input.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') { event.preventDefault(); resetSearch(); }
  });
  clearButton.addEventListener('click', resetSearch);
  resetButton.addEventListener('click', resetSearch);
  loadMore.addEventListener('click', () => {
    const nextSlug = search(input.value)[limit];
    limit += pageSize;
    render();
    // Keep keyboard users at the beginning of the newly revealed articles.
    if (nextSlug) cards.get(nextSlug)?.querySelector('a')?.focus({ preventScroll: true });
  });
  window.addEventListener('popstate', () => {
    input.value = new URLSearchParams(window.location.search).get('q') ?? '';
    limit = pageSize;
    render();
  });
  render();
</script>
