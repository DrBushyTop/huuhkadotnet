---
import '@fontsource-variable/geist';
import '@fontsource-variable/source-sans-3';
import '../styles/global.css';
import '../styles/code.css';
import Header from '../components/Header.astro';
interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Articles by Pasi Huuhka on DevOps, Azure, and building software with AI." />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Huuhka.net RSS" href="https://www.huuhka.net/rss/" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to articles</a>
    <Header />
    <slot />
    <footer class="site-footer page-width">
      <p>© {new Date().getFullYear()} Pasi Huuhka</p>
      <p>Design preview. Article links open the current huuhka.net.</p>
      <a href="https://www.huuhka.net/rss/">RSS feed</a>
    </footer>
  </body>
</html>
